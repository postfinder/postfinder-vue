{
  "name": "@postfinder/vue",
  "version": "0.1.1",
  "description": "Vue composables and an accessible combobox for finding post offices, parcel lockers and post boxes nearby",
  "keywords": [
    "vue store locator",
    "post office locator",
    "parcel locker api",
    "nearest location",
    "location search",
    "postcode lookup",
    "combobox",
    "typeahead",
    "vue",
    "vue3",
    "openstreetmap",
    "australia"
  ],
  "license": "MIT",
  "homepage": "https://postfinder.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postfinder/postfinder-vue.git"
  },
  "bugs": {
    "url": "https://github.com/postfinder/postfinder-vue/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
